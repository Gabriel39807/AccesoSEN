# ===============================
# Root environment template (S.A.D.I)
# Copy to .env and adjust values.
# ===============================

# ---------- Database / Docker ----------
POSTGRES_DB=accesosen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---------- Django runtime ----------
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIMEZONE=America/Bogota
DJANGO_LOG_LEVEL=INFO

# ---------- Institution profile ----------
INSTITUTION_NAME=Institucion Demo
SEDES_PROFILE=generic
INSTITUTION_SUPPORT_EMAIL=soporte@institucion.local

# ---------- Database connection ----------
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=accesosen
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# ---------- CORS / CSRF ----------
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- JWT / sessions ----------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true
JWT_UPDATE_LAST_LOGIN=true
REFRESH_TOKEN_PEPPER=change-this-pepper
GUARDA_SINGLE_ACTIVE_SESSION=true

# ---------- Email / OTP ----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@sadi.local

# ---------- Superadmin bootstrap ----------
DEFAULT_SUPERADMIN_AUTO_CREATE=true
DEFAULT_SUPERADMIN_USERNAME=superadmin
DEFAULT_SUPERADMIN_EMAIL=superadmin@sadi.local
DEFAULT_SUPERADMIN_PASSWORD=Superadmin123!

# ---------- WebAuthn / passkeys ----------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SADI
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_MOCK=true

# ---------- Production hardening ----------
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
USE_X_FORWARDED_PROTO=true

# ---------- Frontend Web ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@institucion.local

# ---------- Frontend Mobile (Expo) ----------
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
