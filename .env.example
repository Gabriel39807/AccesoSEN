# ==========================================
# S.A.D.I - Root environment template
# Copy this file to `.env` and replace values.
# ==========================================

# PostgreSQL database name (docker/local).
POSTGRES_DB=sadi_db
# PostgreSQL database user.
POSTGRES_USER=sadi_user
# PostgreSQL database password.
POSTGRES_PASSWORD=tu_password_db_seguro
# PostgreSQL exposed port.
POSTGRES_PORT=5432

# Django environment: development | base | production.
DJANGO_ENV=development
# Django debug mode (true only in local dev).
DJANGO_DEBUG=true
# Django secret key (required; generate a long random string).
DJANGO_SECRET_KEY=tu_django_secret_key_largo_y_aleatorio
# Allowed hosts for Django, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Backend timezone.
DJANGO_TIMEZONE=America/Bogota
# Root logger level.
DJANGO_LOG_LEVEL=INFO

# Branding name shown in templates/frontends.
INSTITUTION_NAME=Institucion Demo
# Seed profile for default sedes: generic | sena.
SEDES_PROFILE=generic
# Support contact email.
INSTITUTION_SUPPORT_EMAIL=soporte@tu-dominio.com

# Django DB engine (sqlite3 for local quickstart, postgresql for prod).
DATABASE_ENGINE=django.db.backends.sqlite3
# Django DB name.
DATABASE_NAME=sadi_db
# Django DB user.
DATABASE_USER=sadi_user
# Django DB password.
DATABASE_PASSWORD=tu_password_db_seguro
# Django DB host.
DATABASE_HOST=127.0.0.1
# Django DB port.
DATABASE_PORT=5432
# Django DB persistent connections lifetime (seconds).
DATABASE_CONN_MAX_AGE=60

# Enable permissive CORS only in local development.
CORS_ALLOW_ALL_ORIGINS=false
# Trusted frontend origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
# Trusted origins for CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Access token lifetime in minutes.
JWT_ACCESS_MINUTES=15
# Refresh token lifetime in days.
JWT_REFRESH_DAYS=14
# Rotate refresh token on each refresh call.
JWT_ROTATE_REFRESH_TOKENS=true
# Blacklist old refresh token after rotation.
JWT_BLACKLIST_AFTER_ROTATION=true
# Update user last_login on token issue.
JWT_UPDATE_LAST_LOGIN=true
# Extra server-side secret for refresh token hashing.
REFRESH_TOKEN_PEPPER=tu_refresh_token_pepper
# Restrict guarda to one active session (true/false).
GUARDA_SINGLE_ACTIVE_SESSION=true

# Django email backend class.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP host used for OTP/password reset.
EMAIL_HOST=smtp.gmail.com
# SMTP port.
EMAIL_PORT=587
# Use TLS for SMTP.
EMAIL_USE_TLS=true
# Use SSL for SMTP.
EMAIL_USE_SSL=false
# SMTP auth user.
EMAIL_HOST_USER=tu_correo_smtp@tu-dominio.com
# SMTP auth password/app password.
EMAIL_HOST_PASSWORD=tu_password_smtp
# Sender address for transactional emails.
DEFAULT_FROM_EMAIL=no-reply@tu-dominio.com

# Auto-create first superadmin on startup (true/false).
DEFAULT_SUPERADMIN_AUTO_CREATE=true
# Bootstrap superadmin username.
DEFAULT_SUPERADMIN_USERNAME=superadmin
# Bootstrap superadmin email.
DEFAULT_SUPERADMIN_EMAIL=superadmin@tu-dominio.com
# Bootstrap superadmin password (required if auto-create=true).
DEFAULT_SUPERADMIN_PASSWORD=tu_password_superadmin_seguro

# WebAuthn RP ID (usually backend/web domain).
WEBAUTHN_RP_ID=localhost
# WebAuthn RP display name.
WEBAUTHN_RP_NAME=SADI
# WebAuthn origin URL.
WEBAUTHN_ORIGIN=http://localhost:3000
# Use mock WebAuthn for local development.
WEBAUTHN_MOCK=true

# Force HTTPS redirect in production.
SECURE_SSL_REDIRECT=true
# Send session cookies only over HTTPS.
SESSION_COOKIE_SECURE=true
# Send CSRF cookies only over HTTPS.
CSRF_COOKIE_SECURE=true
# HSTS max-age.
SECURE_HSTS_SECONDS=31536000
# Apply HSTS to subdomains.
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Allow HSTS preload.
SECURE_HSTS_PRELOAD=true
# Trust X-Forwarded-Proto from reverse proxy.
USE_X_FORWARDED_PROTO=true

# Public web URL for backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public support email in web UI.
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tu-dominio.com
# Public institution name rendered in web UI.
NEXT_PUBLIC_INSTITUTION_NAME=Institucion
# Generic label for sede/campus in web UI.
NEXT_PUBLIC_SEDE_LABEL=La Sede
# Placeholder domain used in admin user forms.
NEXT_PUBLIC_EMAIL_PLACEHOLDER_DOMAIN=institucion.local

# Public mobile URL for backend API.
EXPO_PUBLIC_API_URL=http://tu-host-backend:8000
# Public institution name rendered in mobile UI.
EXPO_PUBLIC_INSTITUTION_NAME=Institucion
# Generic label for sede/campus in mobile UI.
EXPO_PUBLIC_SEDE_LABEL=La Sede
