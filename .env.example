# ==========================================
# S.A.D.I - Root environment template
# Copy this file to `.env` and replace values.
# ==========================================

# PostgreSQL database name (docker/local).
POSTGRES_DB=sadi_db
# PostgreSQL database user.
POSTGRES_USER=sadi_user
# PostgreSQL database password.
POSTGRES_PASSWORD=tu_password_db_seguro
# PostgreSQL exposed port.
POSTGRES_PORT=5432

# Django environment: development | base | production.
DJANGO_ENV=development
# Django debug mode (true only in local dev).
DJANGO_DEBUG=true
# Django secret key (required; generate a long random string).
DJANGO_SECRET_KEY=tu_django_secret_key_largo_y_aleatorio
# Allowed hosts for Django, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Backend timezone.
DJANGO_TIMEZONE=America/Bogota
# Root logger level.
DJANGO_LOG_LEVEL=INFO

# Branding name shown in templates/frontends.
INSTITUTION_NAME=Institucion Demo
# Seed profile for default sedes: generic | sena.
SEDES_PROFILE=generic
# Support contact email.
INSTITUTION_SUPPORT_EMAIL=soporte@tu-dominio.com

# Django DB engine (sqlite3 for local quickstart, postgresql for prod).
DATABASE_ENGINE=django.db.backends.sqlite3
# Django DB name.
DATABASE_NAME=sadi_db
# Django DB user.
DATABASE_USER=sadi_user
# Django DB password.
DATABASE_PASSWORD=tu_password_db_seguro
# Django DB host.
DATABASE_HOST=127.0.0.1
# Django DB port.
DATABASE_PORT=5432
# Django DB persistent connections lifetime (seconds).
DATABASE_CONN_MAX_AGE=60
# Cache backend: auto | redis | database | locmem.
CACHE_BACKEND=auto
# Use DB-backed cache fallback on PostgreSQL when REDIS_URL is missing.
CACHE_USE_DATABASE_FALLBACK=true
# Cache table name for DatabaseCache backend.
CACHE_TABLE=django_cache
# Default cache timeout (seconds).
CACHE_DEFAULT_TIMEOUT=300
# Redis URL (recommended for production).
REDIS_URL=

# Enable permissive CORS only in local development.
CORS_ALLOW_ALL_ORIGINS=false
# Trusted frontend origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
# Trusted origins for CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Access token lifetime in minutes.
JWT_ACCESS_MINUTES=15
# Refresh token lifetime in days.
JWT_REFRESH_DAYS=14
# Rotate refresh token on each refresh call.
JWT_ROTATE_REFRESH_TOKENS=true
# Blacklist old refresh token after rotation.
JWT_BLACKLIST_AFTER_ROTATION=true
# Update user last_login on token issue.
JWT_UPDATE_LAST_LOGIN=true
# Extra server-side secret for refresh token hashing.
REFRESH_TOKEN_PEPPER=tu_refresh_token_pepper
# Enable refresh token cookie mode (web dual transport).
AUTH_COOKIE_REFRESH_ENABLED=true
# Refresh cookie name.
AUTH_COOKIE_REFRESH_NAME=sadi_refresh
# Restrict refresh cookie to API path.
AUTH_COOKIE_REFRESH_PATH=/api/
# Cookie domain override (empty = current host).
AUTH_COOKIE_REFRESH_DOMAIN=
# Send refresh cookie only over HTTPS in production.
AUTH_COOKIE_REFRESH_SECURE=false
# Cookie SameSite policy: Lax | Strict | None.
AUTH_COOKIE_REFRESH_SAMESITE=Lax
# Keep refresh token in response body for legacy clients during transition.
AUTH_COOKIE_REFRESH_LEGACY_BODY=true
# Restrict guarda to one active session (true/false).
GUARDA_SINGLE_ACTIVE_SESSION=true
# Exempt superadmin from email-domain policy checks (true/false).
DOMAIN_POLICY_EXEMPT_SUPERADMIN=false

# Login rate-limit: max invalid attempts before temporary lock.
LOGIN_MAX_ATTEMPTS=5
# Rolling window in seconds for login attempts.
LOGIN_WINDOW_SEC=900
# Progressive lock durations (seconds) per lockout event.
LOGIN_PROGRESSIVE_LOCKOUT_SECONDS=60,180,300,900,1800
# Minimum lock duration for IP-based lock.
LOGIN_IP_LOCK_SEC=60
# After this number of temporary lockouts, force password recovery.
REPEATED_LOCKOUT_THRESHOLD=5
# Window (hours) used to accumulate repeated lockouts.
REPEATED_LOCKOUT_WINDOW_HOURS=24
# Idempotency cache TTL (seconds) for critical write endpoints.
IDEMPOTENCY_TTL_SEC=600
# Idempotency lock TTL (seconds) for in-flight duplicate requests.
IDEMPOTENCY_LOCK_SEC=30

# Gemini AI integration (feature-flagged).
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SEC=12
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BACKOFF_MS=250
GEMINI_RATE_LIMIT_ATTEMPTS=10
GEMINI_RATE_LIMIT_WINDOW_SEC=60
GEMINI_RATE_LIMIT_LOCK_SEC=60

# Django email backend class.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP host used for OTP/password reset.
EMAIL_HOST=smtp.gmail.com
# SMTP port.
EMAIL_PORT=587
# Use TLS for SMTP.
EMAIL_USE_TLS=true
# Use SSL for SMTP.
EMAIL_USE_SSL=false
# SMTP auth user.
EMAIL_HOST_USER=tu_correo_smtp@tu-dominio.com
# SMTP auth password/app password.
EMAIL_HOST_PASSWORD=tu_password_smtp
# Sender address for transactional emails.
DEFAULT_FROM_EMAIL=no-reply@tu-dominio.com

# Auto-create first superadmin on startup (true/false).
DEFAULT_SUPERADMIN_AUTO_CREATE=true
# Bootstrap superadmin username.
DEFAULT_SUPERADMIN_USERNAME=superadmin
# Bootstrap superadmin email.
DEFAULT_SUPERADMIN_EMAIL=superadmin@tu-dominio.com
# Bootstrap superadmin password (required if auto-create=true).
DEFAULT_SUPERADMIN_PASSWORD=tu_password_superadmin_seguro

# WebAuthn RP ID (usually backend/web domain).
WEBAUTHN_RP_ID=localhost
# WebAuthn RP display name.
WEBAUTHN_RP_NAME=SADI
# WebAuthn origin URL.
WEBAUTHN_ORIGIN=http://localhost:3000
# Use mock WebAuthn for local development.
WEBAUTHN_MOCK=true

# Force HTTPS redirect in production.
SECURE_SSL_REDIRECT=true
# Send session cookies only over HTTPS.
SESSION_COOKIE_SECURE=true
# Send CSRF cookies only over HTTPS.
CSRF_COOKIE_SECURE=true
# HSTS max-age.
SECURE_HSTS_SECONDS=31536000
# Apply HSTS to subdomains.
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Allow HSTS preload.
SECURE_HSTS_PRELOAD=true
# Trust X-Forwarded-Proto from reverse proxy.
USE_X_FORWARDED_PROTO=true

# Public web URL for backend API.
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com
NEXT_PUBLIC_API_TIMEOUT_MS=20000
# Supabase URL consumed by web clients when supabase-js is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co
# Supabase publishable key for web clients (never service_role).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplaza_esta_clave
# Legacy anon key fallback for web clients (public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...reemplaza_esta_clave
# Public support email in web UI.
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tu-dominio.com
# Public institution name rendered in web UI.
NEXT_PUBLIC_INSTITUTION_NAME=Institucion
# Generic label for sede/campus in web UI.
NEXT_PUBLIC_SEDE_LABEL=La Sede
# Placeholder domain used in admin user forms.
NEXT_PUBLIC_EMAIL_PLACEHOLDER_DOMAIN=institucion.local

# Public mobile URL for backend API.
EXPO_PUBLIC_API_URL=https://api.tu-dominio.com
# Supabase URL consumed by mobile clients when supabase-js is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co
# Supabase publishable key for mobile clients (never service_role).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplaza_esta_clave
# Legacy anon key fallback for mobile clients (public).
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...reemplaza_esta_clave
# Public institution name rendered in mobile UI.
EXPO_PUBLIC_INSTITUTION_NAME=Institucion
# Generic label for sede/campus in mobile UI.
EXPO_PUBLIC_SEDE_LABEL=La Sede
