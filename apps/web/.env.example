# Backend API base URL consumed by web app.
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com
NEXT_PUBLIC_API_TIMEOUT_MS=20000
# Enable cookie-based auth transport (recommended).
NEXT_PUBLIC_AUTH_COOKIE_MODE=true
# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co
# Supabase publishable key (public, never service_role).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplaza_esta_clave
# Legacy anon key fallback (public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...reemplaza_esta_clave
# Support email displayed in help views.
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tu-dominio.com
# Institution display name used in generic UI texts.
NEXT_PUBLIC_INSTITUTION_NAME=Institucion
# Generic label shown for location fields.
NEXT_PUBLIC_SEDE_LABEL=La Sede
# Email placeholder domain for admin user forms.
NEXT_PUBLIC_EMAIL_PLACEHOLDER_DOMAIN=institucion.local
