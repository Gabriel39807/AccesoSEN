# Expo public API base URL used by mobile client.
# For physical devices use LAN IP or public domain (not localhost).
# Example: http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=http://tu-host-backend:8000
# Institution display name for generic branding in mobile.
EXPO_PUBLIC_INSTITUTION_NAME=Institucion
# Generic label for campus/branch references.
EXPO_PUBLIC_SEDE_LABEL=La Sede
