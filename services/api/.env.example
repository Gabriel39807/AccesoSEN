# Django environment: development | base | production.
DJANGO_ENV=development
# Enable debug only in local development.
DJANGO_DEBUG=true
# Django secret key (required).
DJANGO_SECRET_KEY=tu_django_secret_key_largo_y_aleatorio
# Allowed hosts (comma separated).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Application timezone.
DJANGO_TIMEZONE=America/Bogota
# Institution display name.
INSTITUTION_NAME=Institucion Demo
# Default sedes seed profile: generic | sena.
SEDES_PROFILE=generic
# Support contact email.
INSTITUTION_SUPPORT_EMAIL=soporte@tu-dominio.com

# Database engine (sqlite3 or postgresql).
DATABASE_ENGINE=django.db.backends.sqlite3
# Optional single PostgreSQL URL (recommended for cloud providers).
# Example Supabase pooler:
# DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL=
# Database name.
DATABASE_NAME=sadi_db
# Database user.
DATABASE_USER=sadi_user
# Database password.
DATABASE_PASSWORD=tu_password_db_seguro
# Database host.
DATABASE_HOST=127.0.0.1
# Database port.
DATABASE_PORT=5432
# PostgreSQL SSL mode (require for Supabase/managed DB).
DATABASE_SSLMODE=require
# Enable PgBouncer-safe mode (recommended when using pooler 6543).
DATABASE_USE_PGBOUNCER=false
# Persistent DB connection age in seconds.
DATABASE_CONN_MAX_AGE=60
# Cache backend: auto | redis | database | locmem.
CACHE_BACKEND=auto
# Use DB-backed cache fallback on PostgreSQL when REDIS_URL is missing.
CACHE_USE_DATABASE_FALLBACK=true
# Cache table name for DatabaseCache backend.
CACHE_TABLE=django_cache
# Default cache timeout (seconds).
CACHE_DEFAULT_TIMEOUT=300
# Redis URL (recommended for production).
REDIS_URL=

# Allow all origins only in local development.
CORS_ALLOW_ALL_ORIGINS=false
# Allowed CORS origins (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
# CSRF trusted origins (comma separated).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT access token TTL in minutes.
JWT_ACCESS_MINUTES=15
# JWT refresh token TTL in days.
JWT_REFRESH_DAYS=14
# Rotate refresh tokens on refresh endpoint.
JWT_ROTATE_REFRESH_TOKENS=true
# Blacklist old refresh tokens after rotation.
JWT_BLACKLIST_AFTER_ROTATION=true
# Update last_login when issuing JWT.
JWT_UPDATE_LAST_LOGIN=true
# Extra server-side pepper for refresh token hashing.
REFRESH_TOKEN_PEPPER=tu_refresh_token_pepper
# Enable refresh token cookie mode (web dual transport).
AUTH_COOKIE_REFRESH_ENABLED=true
# Refresh cookie name.
AUTH_COOKIE_REFRESH_NAME=sadi_refresh
# Restrict refresh cookie to API path.
AUTH_COOKIE_REFRESH_PATH=/api/
# Cookie domain override (empty = current host).
AUTH_COOKIE_REFRESH_DOMAIN=
# Send refresh cookie only over HTTPS in production.
AUTH_COOKIE_REFRESH_SECURE=false
# Cookie SameSite policy: Lax | Strict | None.
AUTH_COOKIE_REFRESH_SAMESITE=Lax
# Keep refresh token in response body for legacy clients during transition.
AUTH_COOKIE_REFRESH_LEGACY_BODY=true
# Restrict guarda sessions to one active session.
GUARDA_SINGLE_ACTIVE_SESSION=true
# Exempt superadmin from email-domain policy checks.
DOMAIN_POLICY_EXEMPT_SUPERADMIN=false

# Login rate-limit: max invalid attempts before temporary lock.
LOGIN_MAX_ATTEMPTS=5
# Rolling window in seconds for login attempts.
LOGIN_WINDOW_SEC=900
# Progressive lock durations (seconds) per lockout event.
LOGIN_PROGRESSIVE_LOCKOUT_SECONDS=60,180,300,900,1800
# Minimum lock duration for IP-based lock.
LOGIN_IP_LOCK_SEC=60
# After this number of temporary lockouts, force password recovery.
REPEATED_LOCKOUT_THRESHOLD=5
# Window (hours) used to accumulate repeated lockouts.
REPEATED_LOCKOUT_WINDOW_HOURS=24
# Idempotency cache TTL (seconds) for critical write endpoints.
IDEMPOTENCY_TTL_SEC=600
# Idempotency lock TTL (seconds) for in-flight duplicate requests.
IDEMPOTENCY_LOCK_SEC=30

# Gemini AI integration (feature-flagged).
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SEC=12
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BACKOFF_MS=250
GEMINI_RATE_LIMIT_ATTEMPTS=10
GEMINI_RATE_LIMIT_WINDOW_SEC=60
GEMINI_RATE_LIMIT_LOCK_SEC=60

# Django email backend class.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP host for OTP/password reset.
EMAIL_HOST=smtp.gmail.com
# SMTP port.
EMAIL_PORT=587
# Use TLS for SMTP.
EMAIL_USE_TLS=true
# Use SSL for SMTP.
EMAIL_USE_SSL=false
# SMTP username/account.
EMAIL_HOST_USER=tu_correo_smtp@tu-dominio.com
# SMTP password or app password.
EMAIL_HOST_PASSWORD=tu_password_smtp
# Sender address for platform emails.
DEFAULT_FROM_EMAIL=no-reply@tu-dominio.com

# Auto-create initial superadmin (true/false).
DEFAULT_SUPERADMIN_AUTO_CREATE=true
# Initial superadmin username.
DEFAULT_SUPERADMIN_USERNAME=superadmin
# Initial superadmin email.
DEFAULT_SUPERADMIN_EMAIL=superadmin@tu-dominio.com
# Initial superadmin password (required if auto-create=true).
DEFAULT_SUPERADMIN_PASSWORD=tu_password_superadmin_seguro

# WebAuthn relying party id.
WEBAUTHN_RP_ID=localhost
# WebAuthn relying party display name.
WEBAUTHN_RP_NAME=SADI
# WebAuthn expected origin.
WEBAUTHN_ORIGIN=http://localhost:3000
# Enable mock passkeys in development.
WEBAUTHN_MOCK=true

# Redirect HTTP to HTTPS in production.
SECURE_SSL_REDIRECT=true
# Session cookies only over HTTPS.
SESSION_COOKIE_SECURE=true
# CSRF cookies only over HTTPS.
CSRF_COOKIE_SECURE=true
# HSTS max-age in seconds.
SECURE_HSTS_SECONDS=31536000
# Apply HSTS to subdomains.
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Allow HSTS preload list.
SECURE_HSTS_PRELOAD=true
# Trust X-Forwarded-Proto from proxy.
USE_X_FORWARDED_PROTO=true
