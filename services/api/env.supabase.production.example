# =========================================
# S.A.D.I Backend - Production (Supabase DB)
# =========================================
#
# Use this template in your backend hosting provider (Render/Railway/Fly).
# Supabase hosts the PostgreSQL database; Django API still runs in your backend host.

# --- Django Core ---
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace_with_long_random_secret
DJANGO_ALLOWED_HOSTS=api.tu-dominio.com,tu-servicio.onrender.com
DJANGO_TIMEZONE=America/Bogota
DJANGO_LOG_LEVEL=INFO

# --- Database (Supabase PostgreSQL pooler) ---
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_URL=postgresql://postgres.tu_project_ref:replace_db_password@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_SSLMODE=require
DATABASE_USE_PGBOUNCER=true
DATABASE_CONN_MAX_AGE=0

# Optional direct connection (mainly for tooling/maintenance)
DATABASE_DIRECT_URL=postgresql://postgres.tu_project_ref:replace_db_password@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# --- Cache / Rate limits ---
CACHE_BACKEND=database
CACHE_TABLE=django_cache
CACHE_DEFAULT_TIMEOUT=300

# --- CORS / CSRF ---
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://tu-frontend.vercel.app

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true
JWT_UPDATE_LAST_LOGIN=true
REFRESH_TOKEN_PEPPER=replace_with_another_random_secret

# --- Login lockout policy ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SEC=900
LOGIN_PROGRESSIVE_LOCKOUT_SECONDS=60,180,300,900,1800
LOGIN_IP_LOCK_SEC=60
REPEATED_LOCKOUT_THRESHOLD=5
REPEATED_LOCKOUT_WINDOW_HOURS=24

# --- Superadmin bootstrap ---
DEFAULT_SUPERADMIN_AUTO_CREATE=false
DEFAULT_SUPERADMIN_USERNAME=superadmin
DEFAULT_SUPERADMIN_EMAIL=admin@tu-dominio.com
DEFAULT_SUPERADMIN_PASSWORD=

# --- Email (OTP/reset) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=tu_correo_smtp@tu-dominio.com
EMAIL_HOST_PASSWORD=replace_smtp_app_password
DEFAULT_FROM_EMAIL=no-reply@tu-dominio.com

# --- WebAuthn ---
WEBAUTHN_MOCK=false
WEBAUTHN_RP_ID=tu-frontend.vercel.app
WEBAUTHN_RP_NAME=SADI
WEBAUTHN_ORIGIN=https://tu-frontend.vercel.app

# --- Security ---
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
USE_X_FORWARDED_PROTO=true
